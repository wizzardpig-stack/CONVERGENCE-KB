{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convergence.local/schemas/rule.schema.json",
  "title": "CONVERGENCE Atomic Rule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "status",
    "tradition",
    "school",
    "source_id",
    "source_locator",
    "claim_type",
    "technique_id",
    "condition",
    "normalized_rule",
    "domains",
    "concepts",
    "evidence_level",
    "empirical_status",
    "textual_certainty",
    "provenance"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{5,79}$"
    },
    "status": {
      "enum": [
        "candidate",
        "approved",
        "rejected",
        "deprecated"
      ]
    },
    "tradition": {
      "type": "string",
      "minLength": 2
    },
    "school": {
      "type": "string",
      "minLength": 2
    },
    "source_id": {
      "type": "string",
      "minLength": 3
    },
    "source_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_title"
      ],
      "properties": {
        "work_title": {
          "type": "string"
        },
        "edition_or_translation": {
          "type": [
            "string",
            "null"
          ]
        },
        "book": {
          "type": [
            "string",
            "null"
          ]
        },
        "chapter": {
          "type": [
            "string",
            "null"
          ]
        },
        "verse": {
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "short_quote": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        }
      }
    },
    "claim_type": {
      "enum": [
        "calculation_rule",
        "interpretive_rule",
        "timing_rule",
        "relationship_rule",
        "classification_rule",
        "technique_rule"
      ]
    },
    "technique_id": {
      "type": "string",
      "minLength": 3
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "calculation_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "condition": {
      "type": "object",
      "description": "Machine-readable triggering condition. Keep keys explicit and tradition-specific."
    },
    "normalized_rule": {
      "type": "string",
      "minLength": 8
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "SELF",
          "MONEY",
          "LOVE",
          "PURPOSE",
          "SHADOW",
          "TIME",
          "CAREER",
          "FAMILY",
          "CREATIVITY",
          "SPIRITUALITY",
          "SEX_INTIMACY",
          "SOCIAL",
          "COMPATIBILITY",
          "LOCATION",
          "HEALTH_SYMBOLISM"
        ]
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "polarity": {
      "enum": [
        "supportive",
        "challenging",
        "contextual",
        "mixed",
        "neutral"
      ]
    },
    "strength_weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_level": {
      "enum": [
        "primary_classical",
        "primary_late",
        "scholarly_translation",
        "official_system_source",
        "technical_secondary",
        "practitioner_secondary",
        "tertiary"
      ]
    },
    "empirical_status": {
      "enum": [
        "astronomical_or_mathematical",
        "traditional_doctrine",
        "modern_system_doctrine",
        "historical_claim",
        "interpretive_hypothesis"
      ]
    },
    "textual_certainty": {
      "enum": [
        "high",
        "medium",
        "low",
        "disputed"
      ]
    },
    "corroborates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "conflicts_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "synthesis_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extracted_by",
        "extracted_at",
        "review_state"
      ],
      "properties": {
        "extracted_by": {
          "type": "string"
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_state": {
          "enum": [
            "unreviewed",
            "reviewed",
            "approved",
            "rejected"
          ]
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_terms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Important terminology used by the source when normalized product terminology differs."
    },
    "transmission_notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Notes about paraphrase, translation, manuscript/edition, or transmission uncertainty that affect interpretation."
    }
  }
}
